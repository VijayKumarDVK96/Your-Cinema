# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/your_cinema
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=your_cinema

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_access_token_key_change_in_production_12345
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_change_in_production_67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# TMDB Configuration
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# AI Service Configuration
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Drive API (Recommended)
# API key: works for files shared as "Anyone with the link".
# Enable the Google Drive API in Google Cloud Console and restrict the key to it.
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key

# Google Drive OAuth (Optional, for private files)
# Create an OAuth 2.0 Client ID (Web application) and add the redirect URI below.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/sources/google-drive/callback

# Optional server-wide OAuth (alternative to per-user "Connect Google Drive")
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ACCESS_TOKEN=

# Encrypts stored Drive access/refresh tokens at rest (recommended in production)
# TOKEN_ENCRYPTION_KEY=change_me_to_a_long_random_string
